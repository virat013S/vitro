--- a/cmake/Tests.cmake
+++ b/cmake/Tests.cmake
@@ -1,4 +1,4 @@
 # This adds ctest support to the project
-enable_testing()
+# enable_testing()  # disabled for Flathub build (CMake 3.28 reserves "test" target)
 
 # By default, ctest runs tests serially
@@ -44,11 +44,11 @@
